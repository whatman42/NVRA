# NVRA Oracle Free Tier environment (no secrets in this example).
# Install copies this to /etc/nvra/nvra.env with mode 0600.
# Do NOT commit real API keys, passwords, or tokens.

NVRA_DATA_DIR=/var/lib/nvra

# Prefer a token file over long-lived secrets in environment:
# NVRA_SESSION_TOKEN=

# Never set LIVE bypass flags. LIVE remains fail-closed until
# administrative policy + all safety prechecks PASS.
